+// Local experiment: compile source with this backend's exact Noir version.
+// Adapted from MIT ProveKit 1.0.1 prepare command, retaining compiler checks.
+fn compile_directory(path: &std::path::Path) -> Result<noirc_artifacts::program::ProgramArtifact> {
+    use nargo::{insert_all_files_for_workspace_into_file_manager, parse_all,
+        ops::{check_program, compile_program, report_errors}};
+    use nargo_toml::{find_root, get_package_manifest, resolve_workspace_from_toml, PackageSelection};
+    use noirc_driver::{CompileOptions, NOIR_ARTIFACT_VERSION_STRING};
+    let root = find_root(&std::fs::canonicalize(path)?, true)?;
+    let workspace = resolve_workspace_from_toml(&get_package_manifest(&root)?,
+        PackageSelection::DefaultOrAll, Some(NOIR_ARTIFACT_VERSION_STRING.to_owned()))?;
+    let mut files = workspace.new_file_manager();
+    insert_all_files_for_workspace_into_file_manager(&workspace, &mut files);
+    let parsed = parse_all(&files);
+    let packages: Vec<_> = workspace.into_iter().filter(|p| p.is_binary()).collect();
+    anyhow::ensure!(packages.len() == 1, "Exactly one circuit is required");
+    let result = compile_program(&files, &parsed, &workspace, packages[0], &CompileOptions::default(), None)
+        .and_then(|(program, warnings)| { check_program(&program)?; Ok((program, warnings)) });
+    Ok(report_errors(result, &files, false, false)?.into())
+}
