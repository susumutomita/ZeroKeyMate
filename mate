#!/usr/bin/env bash
# Launch the real app; never inject accounts, proofs, or payment outcomes.
set -euo pipefail
umask 077
ROOT="$(cd "$(dirname "$0")" && pwd)"
cd "$ROOT"
if [[ "${1:-}" == stop ]]; then
  [[ $# == 1 ]] || { echo 'Usage: ./mate stop' >&2;exit 2; }
  exec node scripts/stop.mjs
fi
MODE=launch
CHOOSE=0
DEVICE="${MATE_DEVICE_UDID:-}"
while [[ $# -gt 0 ]]; do
  case "$1" in
    --choose) CHOOSE=1; shift ;;
    --verify) MODE=verify; shift ;;
    --readiness) MODE=readiness; shift ;;
    --device)
      [[ $# -ge 2 && -n "$2" && "$2" != --* ]] || { echo 'A device UDID or auto is required.' >&2;exit 2; }
      DEVICE="$2";shift 2 ;;
    --simulator) DEVICE="";shift ;;
    --help) printf '%s\n' 'make start: choose Simulator or iPhone; make start-device: iPhone; make start-simulator: Simulator' './mate [--choose | --simulator | --device auto|UDID] [--verify | --readiness]' './mate stop: request shutdown of owned services in this checkout';exit 0 ;;
    *) echo "Unknown argument: $1" >&2;exit 2 ;;
  esac
done
if [[ "$CHOOSE" == 1 ]]; then
  printf '%s\n' 'Choose where to launch Mate.' '  1) iPhone Simulator' '  2) Physical iPhone (USB)' '  q) Cancel'
  while true; do
    printf 'Enter a choice [1/2/q]: '
    if ! IFS= read -r choice; then
      printf '\nNo input received. Launch cancelled. Use make start-simulator or make start-device to launch directly.\n' >&2
      exit 2
    fi
    case "$choice" in
      1) DEVICE=""; break ;;
      2) DEVICE="${MATE_DEVICE_UDID:-auto}"; break ;;
      q|Q) echo 'Launch cancelled.'; exit 0 ;;
      *) echo 'Enter 1, 2 or q.' ;;
    esac
  done
fi
command -v node >/dev/null || { echo 'Install Node.js 22.16+ (22.x) or 24.x first.' >&2;exit 1; }
if [[ "$MODE" == readiness ]]; then
  exec node --env-file-if-exists=.env scripts/readiness.mjs
fi
[[ "$(uname -s)" == Darwin && "$(uname -m)" == arm64 ]] || { echo 'Native launch requires an Apple Silicon Mac.' >&2;exit 1; }
command -v xcodebuild >/dev/null || { echo 'Install Xcode 26 or newer first.' >&2;exit 1; }
MAJOR="$(xcodebuild -version | awk '/^Xcode /{split($2,v,".");print v[1]}')"
[[ "$MAJOR" =~ ^[0-9]+$ && "$MAJOR" -ge 26 ]] || { echo 'Xcode 26 or newer is required.' >&2;exit 1; }
xcodebuild -checkFirstLaunchStatus >/dev/null 2>&1 || { echo 'Complete Xcode first launch and its license agreement.' >&2;exit 1; }
if [[ "$MODE" == verify ]]; then
  python3 scripts/validate-native-runtime.py
  python3 scripts/validate-proof-resources.py
  make test test-ios
  echo 'Simulator acceptance completed. This is not physical DockKit or live financial acceptance.'
  exit 0
fi
if [[ -n "$DEVICE" ]]; then
  if [[ "${MATE_REQUIRE_API_CONNECTION:-0}" == 1 ]]; then
    node --env-file-if-exists=.env scripts/check-device-api.mjs
  fi
  echo 'Checking the connected iPhone and signing team.'
  # Keep assignment separate from export so a failed selector stops this script.
  MATE_DEVELOPMENT_TEAM="$(python3 scripts/device-launch.py team)"
  export MATE_DEVELOPMENT_TEAM
  DEVICE="$(python3 scripts/device-launch.py device "$DEVICE")"
  make project
  export VERITY_SWIFT_SDK_MODE=source-only
  if [[ "${MATE_PROOF_RUNTIME:-auto}" != source-only && -f .tools/verity/output/Verity.xcframework/mate-runtime.json ]]; then export VERITY_SWIFT_SDK_MODE=native;fi
  extra=(-IDEPackageSupportDisableManifestSandbox=NO)
  if [[ "${MATE_NESTED_SANDBOX:-0}" == 1 ]]; then
    extra=(-IDEPackageSupportDisableManifestSandbox=YES 'OTHER_SWIFT_FLAGS=$(inherited) -disable-sandbox')
  fi
  echo 'Building and signing the iPhone app.'
  xcodebuild -quiet -project apps/ios/ZeroKeyMate.xcodeproj -scheme ZeroKeyMate -configuration Debug \
    -destination "id=$DEVICE" -derivedDataPath .build/NativeDevice \
    -clonedSourcePackagesDirPath "$ROOT/.build/SourcePackages" \
    -packageCachePath "$ROOT/.build/PackageCache" -disablePackageRepositoryCache "${extra[@]}" \
    "DEVELOPMENT_TEAM=$MATE_DEVELOPMENT_TEAM" -allowProvisioningUpdates -allowProvisioningDeviceRegistration build
  APP="$ROOT/.build/NativeDevice/Build/Products/Debug-iphoneos/ZeroKeyMate.app"
  echo 'Installing on iPhone.'
  xcrun devicectl --timeout 120 device install app --device "$DEVICE" "$APP"
  echo 'Launching Mate on iPhone.'
  xcrun devicectl --timeout 30 device process launch --device "$DEVICE" com.zerokeymate.companion
else
  make build-ios
  ID="$(python3 scripts/select-simulator.py)"
  if ! xcrun simctl list devices booted | grep -Fq "$ID"; then xcrun simctl boot "$ID";fi
  xcrun simctl bootstatus "$ID" -b
  APP="$ROOT/DerivedData/Build/Products/Debug-iphonesimulator/ZeroKeyMate.app"
  xcrun simctl install "$ID" "$APP"
  xcrun simctl launch "$ID" com.zerokeymate.companion
  if [[ "${CI:-}" != true ]]; then open -a Simulator --args -CurrentDeviceUDID "$ID";fi
fi
echo 'Mate launched. Camera and microphone require an explicit start.'
