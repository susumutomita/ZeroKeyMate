#!/usr/bin/env bash
# One entry point. No simulator seed accounts, fake providers or canned model replies.
set -euo pipefail
umask 077
ROOT="$(cd "$(dirname "$0")" && pwd)"
cd "$ROOT"
MODE=launch
DEVICE=""
if [[ $# -gt 0 ]]; then
  case "$1" in
    configure|setup|register-provider|services|provider|stop|doctor) MODE="$1"; shift ;;
    --verify) MODE=verify; shift ;;
    --readiness) MODE=doctor; shift ;;
    --help)
      printf '%s\n' './mate                  Build and open the real native app in Simulator.' \
        './mate --device auto    Sign, install and launch on your paired iPhone.' \
        './mate configure        Create .env and local testnet-service keys, without transactions.' \
        './mate setup            Deploy the testnet vault and link your owned ENSv2 parent.' \
        './mate register-provider Register the actual specialist in ERC-8004 and ENS.' \
        './mate services         Start the authenticated API and the real local-model provider.' \
        './mate provider         Start just the specialist, for metadata publication/setup.' \
        './mate stop             Stop only services started by this checkout.' \
        './mate doctor           Report missing dependencies/configuration without claiming verification.' \
        './mate --verify         Explicitly run native acceptance tests.'
      exit 0 ;;
  esac
fi
while [[ $# -gt 0 ]]; do
 case "$1" in
  --device) [[ $# -ge 2 ]] || { echo '--device requires auto or an identifier.' >&2;exit 2; };DEVICE="$2";shift 2;;
  --simulator) DEVICE="";shift;;
  *) echo "Unknown option: $1" >&2;exit 2;;
 esac
done
[[ "$(uname -s)" == Darwin && "$(uname -m)" == arm64 ]] || {
  echo 'Native launch requires an Apple Silicon Mac. The API/provider can also run with Node 22 on Linux.' >&2;exit 1;
}
command -v brew >/dev/null || { echo 'Homebrew is required to prepare build dependencies.' >&2;exit 1; }
export HOMEBREW_NO_AUTO_UPDATE=1
if ! command -v node >/dev/null || [[ "$(node -p 'process.versions.node.split(".")[0]')" != 22 ]]; then
 brew list --versions node@22 >/dev/null 2>&1 || brew install node@22
 export PATH="$(brew --prefix node@22)/bin:$PATH"
fi
if [[ "$MODE" == stop ]]; then exec node scripts/services.mjs stop; fi
if [[ "$MODE" == doctor ]]; then exec node --env-file-if-exists=.env scripts/doctor.mjs; fi
if [[ -f package-lock.json ]]; then npm ci --ignore-scripts; else npm install --ignore-scripts; fi
if [[ "$MODE" == configure ]]; then exec node scripts/initialize-environment.mjs; fi
node --env-file-if-exists=.env scripts/generate-app-config.mjs
if [[ "$MODE" == register-provider ]]; then exec node --env-file-if-exists=.env scripts/register-provider.mjs; fi
if [[ "$MODE" == setup ]]; then
 node scripts/compile-contracts.mjs
 exec node --env-file-if-exists=.env scripts/setup-sepolia.mjs
fi
if [[ "$MODE" == services || "$MODE" == provider ]]; then
 if [[ "$MODE" == services ]]; then
  node scripts/compile-contracts.mjs
  if ! command -v rustup >/dev/null; then brew install rustup; export PATH="$(brew --prefix rustup)/bin:$HOME/.cargo/bin:$PATH"; fi
  bash scripts/build-proofs.sh
  cargo +nightly-2026-03-04 build --release --locked --manifest-path services/verifier/Cargo.toml
 fi
 if ! command -v ollama >/dev/null; then brew install ollama; fi
 exec node --env-file-if-exists=.env scripts/services.mjs "$MODE"
fi
command -v xcodebuild >/dev/null || { echo 'Install Xcode 26.3 or newer and select it with xcode-select.' >&2;exit 1; }
VERSION="$(xcodebuild -version | awk '/^Xcode /{print $2}')"
python3 - "$VERSION" <<'PYVERSION'
import sys
parts=tuple(int(x) for x in sys.argv[1].split('.')[:2])
if parts < (26,3):
    raise SystemExit('Xcode 26.3 or newer is required.')
PYVERSION
xcodebuild -checkFirstLaunchStatus >/dev/null 2>&1 || { echo 'Complete Xcode first launch and license acceptance.' >&2;exit 1; }
command -v xcodegen >/dev/null || brew install xcodegen
command -v python3 >/dev/null || brew install python
if ! python3 scripts/validate-native-runtime.py >/dev/null 2>&1; then
 if ! command -v rustup >/dev/null; then brew install rustup; export PATH="$(brew --prefix rustup)/bin:$HOME/.cargo/bin:$PATH"; fi
 bash scripts/build-native-runtime.sh
fi
python3 scripts/validate-native-runtime.py
if ! python3 scripts/validate-proof-resources.py >/dev/null 2>&1; then
 if ! command -v rustup >/dev/null; then brew install rustup; export PATH="$(brew --prefix rustup)/bin:$HOME/.cargo/bin:$PATH"; fi
 bash scripts/build-proofs.sh
fi
export VERITY_SWIFT_SDK_MODE=native
make project
mkdir -p .build/launch
ARGS=(-quiet -project apps/ios/ZeroKeyMate.xcodeproj -scheme ZeroKeyMate -configuration Debug)
if [[ -n "$DEVICE" ]]; then
 TEAM="$(node --env-file-if-exists=.env -p 'process.env.MATE_DEVELOPMENT_TEAM || ""')"
 [[ "$TEAM" =~ ^[A-Z0-9]{10}$ ]] || { echo 'Set MATE_DEVELOPMENT_TEAM in .env to your Apple development team identifier.' >&2;exit 1; }
 if [[ "$DEVICE" == auto ]]; then DEVICE="$(python3 scripts/select-device.py)"; fi
 DERIVED="$ROOT/.build/NativeDevice"
 xcodebuild "${ARGS[@]}" -destination "id=$DEVICE" -derivedDataPath "$DERIVED" \
  "DEVELOPMENT_TEAM=$TEAM" -allowProvisioningUpdates build 2>&1 | tee .build/launch/device-build.log
 APP="$DERIVED/Build/Products/Debug-iphoneos/ZeroKeyMate.app"
 [[ -d "$APP" ]] || { echo 'The signed app was not produced.' >&2;exit 1; }
 xcrun devicectl device install app --device "$DEVICE" "$APP"
 xcrun devicectl device process launch --device "$DEVICE" com.zerokeymate.companion
else
 ID="$(python3 scripts/select-simulator.py)"
 if ! xcrun simctl list devices booted | grep -Fq "$ID"; then xcrun simctl boot "$ID"; fi
 xcrun simctl bootstatus "$ID" -b
 DERIVED="$ROOT/.build/NativeSimulator"
 if [[ "$MODE" == verify ]]; then
  RESULT="$ROOT/.build/launch/acceptance-$(date -u +%Y%m%dT%H%M%SZ).xcresult"
  xcodebuild "${ARGS[@]}" -destination "platform=iOS Simulator,id=$ID" -derivedDataPath "$DERIVED" \
   -resultBundlePath "$RESULT" ARCHS=arm64 ONLY_ACTIVE_ARCH=YES CODE_SIGN_IDENTITY=- CODE_SIGNING_ALLOWED=YES DEVELOPMENT_TEAM= test \
   2>&1 | tee .build/launch/native-tests.log
 else
  xcodebuild "${ARGS[@]}" -destination "platform=iOS Simulator,id=$ID" -derivedDataPath "$DERIVED" \
   ARCHS=arm64 ONLY_ACTIVE_ARCH=YES CODE_SIGN_IDENTITY=- CODE_SIGNING_ALLOWED=YES DEVELOPMENT_TEAM= build \
   2>&1 | tee .build/launch/simulator-build.log
 fi
 APP="$DERIVED/Build/Products/Debug-iphonesimulator/ZeroKeyMate.app"
 [[ -d "$APP" ]] || { echo 'The app was not produced.' >&2;exit 1; }
 xcrun simctl install "$ID" "$APP"
 xcrun simctl launch "$ID" com.zerokeymate.companion
 open -a Simulator --args -CurrentDeviceUDID "$ID"
fi
printf '%s\n' 'Mate launched. Sensors start only with consent. Live integrations require your configured accounts and deployments.'
