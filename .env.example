# Never commit a populated .env. ./mate configure creates local random keys and
# pairing tokens without touching chain state. No mainnet is supported.
SEPOLIA_RPC_URL=https://ethereum-sepolia-rpc.publicnode.com
# A public app ID + iOS client ID from your Privy project (email login enabled).
PRIVY_APP_ID=
PRIVY_IOS_CLIENT_ID=
# Install-scoped capability. Treat the signed app bundle as private, not a release artifact.
MATE_API_URL=http://127.0.0.1:8787
MATE_API_TOKEN=
MATE_JOURNAL_KEY=
MATE_RELAYER_PRIVATE_KEY=
MATE_ATTESTOR_PRIVATE_KEY=
MATE_VAULT_ADDRESS=
MATE_TOKEN_ADDRESS=0x1c7D4B196Cb0C7B01d743Fbc6116a902379C7238
MATE_BIND_HOST=127.0.0.1
MATE_PORT=8787
# Physical iPhone: an authenticated HTTPS endpoint reaching the local API is required.
# Configure TLS using your reverse proxy or Tailscale Serve; do not expose an unauthenticated port.
MATE_DEVELOPMENT_TEAM=
MATE_DEVICE_UDID=
# Own this parent on the *ENSv2 Sepolia deployment* in config/ens-sepolia.json.
ENS_PARENT_NAME=
ENS_OPERATOR_PRIVATE_KEY=
ENS_SUBREGISTRY_ADDRESS=
ENS_RESOLVER_FACTORY=
GRAPH_API_KEY=
GRAPH_SUBGRAPH_ID=6wQRC7geo9XYAhckfmfo8kbMRLeWU8KQd3XsJqFKmZLT
MATE_PROVIDERS_JSON=[]
# Real local Ollama model. ./mate services loads the configured model if necessary.
PROVIDER_MODEL_URL=http://127.0.0.1:11434
PROVIDER_MODEL=gemma3:4b
PROVIDER_API_TOKEN=
PROVIDER_JOURNAL_KEY=
PROVIDER_PORT=8788
PROVIDER_RECIPIENT_ADDRESS=
PROVIDER_PRICE_UNITS=10000
PROVIDER_PUBLIC_URL=
PROVIDER_ENS_LABEL=specialist
PROVIDER_REGISTRATION_FILE=
# The real ERC-8004 IdentityRegistry for the matching Agent0 Sepolia subgraph.
AGENT_REGISTRY_ADDRESS=
