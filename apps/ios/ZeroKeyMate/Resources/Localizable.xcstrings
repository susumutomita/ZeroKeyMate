    "Measured with a monotonic clock on this device. Total includes preparation; queue wait and modified-proof checking are excluded. First key loading is not a cold-device benchmark. Peak memory requires a separate Xcode measurement.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Measured with a monotonic clock on this device. Total includes preparation; queue wait and modified-proof checking are excluded. First key loading is not a cold-device benchmark. Peak memory requires a separate Xcode measurement."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この端末の単調時計で計測しています。全体時間には準備を含み、待機時間と改変証明の確認は含みません。初回の鍵読み込みは端末のコールド起動計測ではありません。ピークメモリはXcodeで別途計測してください。"
          }
        }
      }
    },
    "Ask Mate to buy a beer. Your iPhone proves you're 20 or older, while your name and birth date stay private.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Ask Mate to buy a beer. Your iPhone proves you're 20 or older, while your name and birth date stay private."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Mateにビールを頼んでみましょう。氏名や生年月日を明かさず、このiPhoneで20歳以上であることを証明します。"
          }
        }
      }
    },
    "Try a beer purchase": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Try a beer purchase"
          }
        },
        "ja": {
          "stringUnit": {
