        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "同じ接続の更新では確認待ちの依頼を保持します。接続先を変更する前に、確認待ちの依頼を解決してください。"
          }
        }
      }
    },
    "Pairing expired. Create a new code on your Mac and renew in Connection settings. Pending requests are preserved.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Pairing expired. Create a new code on your Mac and renew in Connection settings. Pending requests are preserved."
