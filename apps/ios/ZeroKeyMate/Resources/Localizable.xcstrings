        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "明示的に開始したカメラの動作中に追跡と小さなリアクションを行います。オフにするか「視差効果を減らす」を有効にするとスタンドの動作を停止します。"
          }
        }
      }
    },
    "One-time pairing code": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "One-time pairing code"
          }
