          }
        }
      }
    },
    "On your Mac, run npm run pair and open the private code file. The code works once within 10 minutes. The device connection lasts one hour or 500 requests.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "On your Mac, run npm run pair and open the private code file. The code works once within 10 minutes. The device connection lasts one hour or 500 requests."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Macで npm run pair を実行し、非公開のコードファイルを開いてください。コードは10分以内に1回だけ使えます。端末の接続は1時間または500リクエストまで有効です。"
          }
        }
      }
    },
    "Pairing expires": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Pairing expires"
          }
        },
        "ja": {
