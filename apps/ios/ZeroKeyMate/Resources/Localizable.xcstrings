          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "実行用口座にテストUSDCがありません。ウォレットで金額を確認・承認してから入金してください。取引ごとに承認が必要です。"
          }
        }
      }
    },
    "Review the services, spending limit and expiry. Only the displayed terms will be signed.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Review the services, spending limit and expiry. Only the displayed terms will be signed."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "サービス、利用上限、有効期限を確認してください。表示された条件だけに署名します。"
          }
        }
      }
    },
    "The connection, wallet, balance and mandate have been checked. Choose a service and review the text and price before placing an order.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The connection, wallet, balance and mandate have been checked. Choose a service and review the text and price before placing an order."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "接続、ウォレット、残高、委任を確認しました。サービスを選び、送信する文章と料金を確認してから注文してください。"
          }
        }
      }
    },
    "Local conversation and private proof checks are available without this setup.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Local conversation and private proof checks are available without this setup."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "端末内の会話や私的ルールの証明確認には、この準備は不要です。"
          }
        }
      }
    },
    "Interrupt and speak": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Interrupt and speak"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "返答を止めて話す"
          }
        }
      }
    },
    "Speak now": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Speak now"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "今すぐ話す"
          }
        }
      }
    },
    "Speak now stops the current reply and listens on this iPhone. Listening continues after replies until you choose Rest. Speaking over a reply does not interrupt it automatically.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Speak now stops the current reply and listens on this iPhone. Listening continues after replies until you choose Rest. Speaking over a reply does not interrupt it automatically."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "「今すぐ話す」で返答を止め、このiPhoneで聞き取りを始めます。「おやすみ」で止めるまで返答後も聞き取りを続けます。返答に声を重ねるだけでは中断しません。"
          }
        }
      }
    },
    "Waiting for approval.": {
